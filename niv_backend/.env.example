# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/niv_db

# API
API_VERSION=v1
API_TITLE=Sistema Generador de NIV
API_DESCRIPTION=API para generación y gestión de NIV según NOM-001-SSP-2008

# Configuración NIV
# Nota: se usa "ANIO" (ASCII) en lugar de "AÑO" para evitar problemas de
# codificación de nombres de variables de entorno entre shells/plataformas.
WMI=3M1
PLANTA_DEFAULT=A
ANIO_INICIO=2026

# Exportación DXF
DXF_ALTURA_TEXTO=3.0
DXF_ESPACIADO=0.5
DXF_FUENTE=Arial

# CORS (lista en formato JSON)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Logging
LOG_LEVEL=INFO
